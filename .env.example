# Copy to .env.local for development. In production these are Vercel
# Environment Variables — set them in the dashboard, never in the repo.
#
# NOTHING here may be prefixed NEXT_PUBLIC_. That prefix ships the value to the
# browser, which for any of these means publishing the credential.

# --- Database -------------------------------------------------------------
# Vercel → Storage → Create → Neon. Connecting it to the project fills this in.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Files ----------------------------------------------------------------
# Vercel → Storage → Create → Blob. Connecting it fills this in.
BLOB_READ_WRITE_TOKEN=

# --- Google sign-in -------------------------------------------------------
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI: https://www.cikoffice.com/api/auth/callback/google
#                     and http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pre-filters the account chooser. Convenience only, not a security control.
# Only used when ALLOWED_EMAIL_DOMAINS has ONE domain (cik-v8).
GOOGLE_HD=

# openssl rand -base64 32  (a NEW one — never reuse Jarvis's)
AUTH_SECRET=
AUTH_URL=https://www.cikoffice.com

# Who may sign in at all. The real gate.
ALLOWED_EMAIL_DOMAINS=cashisking.com,matinrealestate.com
# Individual addresses allowed alongside the domains (optional).
ALLOWED_EMAILS=

# Where links in help-ticket emails point.
JARVIS_ORIGIN=https://www.cikoffice.com

# --- Help-ticket email (optional) -----------------------------------------
# A Zapier "Catch Hook" address. New tickets are POSTed there; leave blank to
# send no emails.
TICKET_EMAIL_HOOK_URL=

# --- Podio (the Deals tab, cik-v5) -----------------------------------------
# The company API key: podio.com → your name → Account settings → API keys
# ("Generate API key"; any app name and the domain www.cikoffice.com).
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
# Each lead app's own token: open the app in Podio → wrench → Developer.
# app id = token, comma-separated. The six lead apps:
#   30240944 Elysium · 30206037 Hot Leads · 30206102 STF · 30255544 LTF
#   30206099 No Response · 30206101 Trash
PODIO_APP_TOKENS=30240944=,30206037=,30206102=,30255544=,30206099=,30206101=
# How often the copy of Podio is brought up to date while someone is looking
# (milliseconds; default 10 minutes).
PODIO_STALE_MS=
